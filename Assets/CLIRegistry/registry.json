{
  "about": "Well-known CLIs shown in the CLIs view. Fields: id, label, bins (first found on the login PATH wins), icon (Simple Icons slug; PNG in icons/), mark (monogram fallback), versionArgs (default [\"--version\"]), versionPattern (regex, first capture group), versionShell / versionSuffix / hideWhenVersion (shell-derived versions), brew / cask / npm (package names matched against the inventory scan, which decides outdated state and the update command), via + selfUpdate (tool's own updater), check {command, outdatedWhenOutput | latestPattern}, github (owner/repo whose latest release is the upstream version). Regenerate icons with scripts/fetch_cli_icons.py.",
  "clis": [
    {"id": "gh", "label": "GitHub CLI", "bins": ["gh"], "icon": "github", "brew": "gh", "github": "cli/cli"},
    {"id": "gh-extensions", "label": "gh extensions", "bins": ["gh"], "icon": "github", "via": "gh",
     "versionShell": "gh extension list 2>/dev/null | grep -c .", "versionPattern": "(\\d+)", "versionSuffix": " installed", "hideWhenVersion": "0",
     "check": {"command": "gh extension upgrade --all --dry-run 2>&1 | grep -i 'would have upgraded'", "outdatedWhenOutput": true},
     "selfUpdate": "gh extension upgrade --all"},
    {"id": "git", "label": "Git", "bins": ["git"], "icon": "git", "brew": "git"},
    {"id": "node", "label": "Node.js", "bins": ["node"], "icon": "nodedotjs", "brew": ["node", "node@22", "node@20"]},
    {"id": "npm", "label": "npm", "bins": ["npm"], "icon": "npm", "npm": "npm", "via": "npm", "selfUpdate": "npm install -g npm@latest", "github": "npm/cli"},
    {"id": "pnpm", "label": "pnpm", "bins": ["pnpm"], "icon": "pnpm", "brew": "pnpm", "npm": "pnpm", "github": "pnpm/pnpm"},
    {"id": "yarn", "label": "Yarn", "bins": ["yarn"], "icon": "yarn", "brew": "yarn", "npm": "yarn"},
    {"id": "bun", "label": "Bun", "bins": ["bun"], "icon": "bun", "brew": "bun", "selfUpdate": "bun upgrade", "github": "oven-sh/bun"},
    {"id": "deno", "label": "Deno", "bins": ["deno"], "icon": "deno", "brew": "deno", "selfUpdate": "deno upgrade", "github": "denoland/deno"},
    {"id": "brew", "label": "Homebrew", "bins": ["brew"], "icon": "homebrew", "via": "self", "selfUpdate": "brew update", "github": "Homebrew/brew"},
    {"id": "uv", "label": "uv", "bins": ["uv"], "icon": "uv", "brew": "uv", "selfUpdate": "uv self update", "github": "astral-sh/uv"},
    {"id": "python", "label": "Python", "bins": ["python3"], "icon": "python", "brew": ["python@3.13", "python@3.12", "python@3.11"]},
    {"id": "go", "label": "Go", "bins": ["go"], "icon": "go", "brew": "go", "versionArgs": ["version"]},
    {"id": "rustup", "label": "Rust (rustup)", "bins": ["rustup"], "icon": "rust", "brew": "rustup", "via": "rustup", "selfUpdate": "rustup update"},
    {"id": "docker", "label": "Docker", "bins": ["docker"], "icon": "docker", "cask": ["docker", "docker-desktop"], "brew": "docker"},
    {"id": "kubectl", "label": "kubectl", "bins": ["kubectl"], "icon": "kubernetes", "brew": "kubernetes-cli", "versionArgs": ["version", "--client"], "github": "kubernetes/kubernetes"},
    {"id": "helm", "label": "Helm", "bins": ["helm"], "icon": "helm", "brew": "helm", "versionArgs": ["version", "--short"], "github": "helm/helm"},
    {"id": "terraform", "label": "Terraform", "bins": ["terraform"], "icon": "terraform", "brew": ["hashicorp/tap/terraform", "terraform"], "github": "hashicorp/terraform"},
    {"id": "pulumi", "label": "Pulumi", "bins": ["pulumi"], "icon": "pulumi", "brew": ["pulumi/tap/pulumi", "pulumi"], "versionArgs": ["version"], "github": "pulumi/pulumi"},
    {"id": "aws", "label": "AWS CLI", "bins": ["aws"], "mark": "AW", "brew": "awscli", "versionPattern": "aws-cli/(\\d+(?:\\.\\d+)+)"},
    {"id": "gcloud", "label": "Google Cloud", "bins": ["gcloud"], "icon": "googlecloud", "cask": ["google-cloud-sdk", "gcloud-cli"], "via": "gcloud",
     "versionPattern": "Google Cloud SDK (\\d+(?:\\.\\d+)+)", "selfUpdate": "gcloud components update --quiet",
     "check": {"command": "gcloud components list --quiet --filter=\"state.name='Update Available'\" --format='value(id)' 2>/dev/null", "outdatedWhenOutput": true}},
    {"id": "az", "label": "Azure CLI", "bins": ["az"], "mark": "AZ", "brew": "azure-cli", "via": "az", "versionPattern": "azure-cli\\s+(\\d+(?:\\.\\d+)+)", "selfUpdate": "az upgrade --yes"},
    {"id": "firebase", "label": "Firebase", "bins": ["firebase"], "icon": "firebase", "npm": "firebase-tools", "brew": "firebase-cli"},
    {"id": "vercel", "label": "Vercel", "bins": ["vercel"], "icon": "vercel", "npm": "vercel", "brew": "vercel-cli"},
    {"id": "netlify", "label": "Netlify", "bins": ["netlify"], "icon": "netlify", "npm": "netlify-cli", "brew": "netlify-cli"},
    {"id": "wrangler", "label": "Wrangler", "bins": ["wrangler"], "icon": "cloudflare", "npm": "wrangler", "brew": "cloudflare-wrangler"},
    {"id": "supabase", "label": "Supabase", "bins": ["supabase"], "icon": "supabase", "brew": ["supabase/tap/supabase", "supabase"], "npm": "supabase", "github": "supabase/cli"},
    {"id": "flyctl", "label": "Fly.io", "bins": ["flyctl", "fly"], "icon": "flydotio", "brew": "flyctl", "versionArgs": ["version"], "selfUpdate": "flyctl version upgrade", "github": "superfly/flyctl"},
    {"id": "heroku", "label": "Heroku", "bins": ["heroku"], "mark": "HK", "brew": ["heroku/brew/heroku", "heroku"], "npm": "heroku", "selfUpdate": "heroku update"},
    {"id": "stripe", "label": "Stripe", "bins": ["stripe"], "icon": "stripe", "brew": ["stripe/stripe-cli/stripe", "stripe"], "github": "stripe/stripe-cli"},
    {"id": "cursor", "label": "Cursor", "bins": ["cursor"], "icon": "cursor", "cask": "cursor", "via": "app"},
    {"id": "cursor-agent", "label": "Cursor Agent", "bins": ["cursor-agent"], "icon": "cursor", "via": "self", "selfUpdate": "cursor-agent update"},
    {"id": "claude", "label": "Claude Code", "bins": ["claude"], "icon": "claude", "npm": "@anthropic-ai/claude-code", "cask": "claude-code", "via": "self", "selfUpdate": "claude update"},
    {"id": "codex", "label": "Codex", "bins": ["codex"], "mark": "CX", "npm": "@openai/codex", "cask": "codex", "brew": "codex", "github": "openai/codex"},
    {"id": "gemini", "label": "Gemini CLI", "bins": ["gemini"], "icon": "googlegemini", "npm": "@google/gemini-cli", "brew": "gemini-cli"}
  ]
}
