#!/usr/bin/env sh
set -eu

usage() {
    cat <<'EOF'
Usage: ./cli <command>

Commands:
  run     Build and open CLI
  build   Build CLI
  dist    Build the distributable archive
  clean   Remove build artifacts
EOF
}

require_build_tools() {
    if ! command -v clang >/dev/null 2>&1; then
        echo "clang is required to build CLI. Install the Xcode Command Line Tools with:" >&2
        echo "  xcode-select --install" >&2
        exit 1
    fi
}

command="${1:-}"

case "$command" in
    run)
        require_build_tools
        make run
        ;;
    build)
        require_build_tools
        make
        ;;
    dist)
        require_build_tools
        make dist
        ;;
    clean)
        make clean
        ;;
    -h|--help|help)
        usage
        ;;
    "")
        usage
        exit 1
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 1
        ;;
esac
